# Copy this file to .env and change the values. Never commit .env.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres (used by docker compose) ---
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support_agent
POSTGRES_PORT=5432

# --- Database URL (used by the app; must match the values above) ---
DATABASE_URL=postgresql+asyncpg://support:change-me@localhost:5432/support_agent

# --- Test database (integration tests WIPE it; never point this at real data) ---
# Same server, separate database. The tests create it automatically if missing.
TEST_DATABASE_URL=postgresql+asyncpg://support:change-me@localhost:5432/support_agent_test

# --- Mock payment provider (optional; seconds a refund spends in each state) ---
MOCK_PAYMENTS_SUBMITTED_SECONDS=2
MOCK_PAYMENTS_PROCESSING_SECONDS=5

# --- External providers (used by the app's integration clients) ---
# Locally these are the mock providers; start them with uvicorn on these ports.
PAYMENTS_BASE_URL=http://localhost:8001
SHIPPING_BASE_URL=http://localhost:8002
TICKETING_BASE_URL=http://localhost:8003
PROVIDER_CONNECT_TIMEOUT_SECONDS=2
PROVIDER_READ_TIMEOUT_SECONDS=5
# Total tries for retried calls. Refund creation is never retried automatically.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_BASE_SECONDS=0.2

# --- Refund policy ---
# Days a customer has to return an item. Measured from the order's delivered_at to the
# date the return was requested (or to today if no return exists yet). Day 30 is still
# inside a 30-day window; day 31 is outside.
REFUND_WINDOW_DAYS=30
# Minutes a reviewer has to approve or reject a refund proposal (1-1440).
APPROVAL_TTL_MINUTES=60

# --- Auth ---
# Signs login tokens. Required, at least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-chars
ACCESS_TOKEN_MINUTES=60
# Password for every seeded demo account (customers and reviewers). Needed by the seed script.
DEMO_PASSWORD=change-me-demo-password
# Optional. Pins the demo scenarios' "N days ago" to noon UTC on this date (YYYY-MM-DD), for
# the database seed and the mock shipping provider alike. Leave blank to use "now": then
# run scripts/reset_demo.py and restart the shipping mock whenever the date has changed.
DEMO_ANCHOR_DATE=
# --- Policy agent ---
# Model tiers for the policy agent (small or large) and its search limit. Search runs on
# small; the findings step needs large (see ADR-009).
POLICY_AGENT_SEARCH_TIER=small
POLICY_AGENT_FINDINGS_TIER=large
POLICY_AGENT_MAX_SEARCHES=4

# --- Policy embeddings ---
# fastembed: the real local model (BAAI/bge-small-en-v1.5, downloaded once, ~70 MB).
# fake: deterministic stand-in vectors with no download (tests and CI only).
EMBEDDING_PROVIDER=fastembed

# --- LLM ---
# groq: Groq is the main provider; Gemini is the fallback, used only if GEMINI_API_KEY is set.
# fake: a scripted offline stand-in that never calls a real API (tests and CI only).
LLM_PROVIDER=groq
# Get keys from https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# small = fast model for simple steps (classifier); large = stronger model for reasoning.
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_LARGE_MODEL=openai/gpt-oss-120b
# gpt-oss models think before answering (counted as output tokens). low|medium|high,
# or blank for models without reasoning.
GROQ_REASONING_EFFORT=low
GEMINI_SMALL_MODEL=gemini-3.5-flash-lite
GEMINI_LARGE_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Tries per provider before falling back to the next one.
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=20
# Classifier confidence (0-1) needed to start investigating; below it, ask the customer.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7
